{
  "name": "zhijian-frontend",
  "description": "Zhijian (纸间): the web interface of an open-source paper-reading workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jialei-03/zhijian.git",
    "directory": "frontend"
  },
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/copy-docs.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:unit": "vitest run",
    "test:ui": "playwright test -c playwright.ui.config.ts",
    "format": "prettier --write src e2e e2e-ui *.ts *.json scripts",
    "check": "tsc -b && prettier --check src e2e e2e-ui *.ts *.json scripts",
    "ui": "shadcn"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@radix-ui/react-presence": "1.1.10",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-mathematics": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "katex": "^0.18.9",
    "lucide-react": "0.468.0",
    "motion": "^13.4.4",
    "pdfjs-dist": "5.4.149",
    "pretendard": "^1.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.12.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sonner": "^2.0.8",
    "swagger-ui-dist": "5.32.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/d3-force": "^3.0.10",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.6.2",
    "shadcn": "^4.21.0",
    "typescript": "5.9.2",
    "vite": "6.4.3",
    "vitest": "3.2.4"
  }
}
