# The simplest way to get HTTPS: Caddy fetches and renews the certificate itself.
# Replace the domain, point its DNS record at this host, then:  caddy run --config Caddyfile.example
reader.example.com {
	encode zstd gzip
	# Uploads are limited by UPLOAD_LIMIT_MB in the application; leave some room.
	request_body {
		max_size 60MB
	}
	# The application sets Cache-Control itself: private data is never cacheable and
	# only content-hashed static files are. Do not add a shared cache in front of it.
	reverse_proxy 127.0.0.1:8765
}
