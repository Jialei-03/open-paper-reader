# Open Paper Reader 配置示例 / configuration example
#
#   cp deploy/.env.example .env
#
# `docker compose --env-file .env -f deploy/docker-compose.yml` 和 `scripts/run.sh` 都会读取 .env。每一项的完整说明见
# docs/CONFIGURATION.md。.env 已在 .gitignore 中，不要把真实密钥提交到版本库。

# ───────────────────────────────────────────────────────────── 基本 / Basics
# development：本机试用，允许 http 与 SQLite。
# production：要求 HTTPS 的 APP_ORIGIN 与 PostgreSQL，Cookie 带 Secure。
APP_ENV=development
# 用户在浏览器里访问的地址。Cookie、CSRF 校验、邮件里的链接都依赖它。
APP_ORIGIN=http://localhost:8765
# open：任何人都能创建账户；invite：注册需要管理员在「设置」里生成的邀请码。
REGISTRATION=open

# ─────────────────────────────────────────────── Docker Compose（deploy/docker-compose.yml）
# PostgreSQL 的密码，必填。
# 只用字母和数字（它会被拼进数据库地址），例如：openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# 对外发布的端口与地址。默认只监听本机；放到公网前请先配置 TLS 反向代理。
# APP_PORT=8765
# BIND_ADDRESS=127.0.0.1
# 反向代理在 Docker 宿主机上、端口只发布在 127.0.0.1 时可设为 *；见 docs/DEPLOYMENT.md。
# FORWARDED_ALLOW_IPS=127.0.0.1

# ───────────────────────────────────────────── 本机运行 / Without Docker (scripts/run.sh)
# 本机默认使用 SQLite。生产使用 PostgreSQL：
#   postgresql+psycopg://paper:PASSWORD@127.0.0.1:5432/paper
DATABASE_URL=sqlite:///./data/platform.db
# 论文、笔记图片、聊天附件等文件的存放目录（不要放进前端目录）。
STORAGE_DIR=./data/files
# 单个上传文件的上限（MB）。
UPLOAD_LIMIT_MB=50

# ─────────────────────────────────────────────────────────── 存储 / Storage
# 每个账户可保存的文件总量（论文文件、笔记图片、聊天附件共用），MB。
USER_STORAGE_LIMIT_MB=1024
# 磁盘剩余空间低于此值时拒绝新的持久文件，MB。
STORAGE_MIN_FREE_MB=1024

# ─────────────────────────────────────────────── 找回账号邮件 / Recovery email（可选）
# 不配置时，设置页会明确提示，找回功能返回 503。需要 STARTTLS。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=reader@example.com
# SMTP_USERNAME=reader@example.com
# SMTP_PASSWORD=只在你的本机环境里设置

# ──────────────────────────────────────────────────────────── 模型 / Models
# 每个账户在设置里添加自己的模型（OpenAI 兼容或 Anthropic 协议）。
# 服务端只允许 HTTPS、443 端口、公网地址，且主机名在内置名单里（OpenAI、Anthropic、
# DeepSeek、OpenRouter、Google AI Studio、SiliconFlow、MiniMax）。其他兼容服务把主机名加到这里，逗号分隔：
# TRANSLATION_ALLOWED_HOSTS=llm.example.com
#
# 由部署者提供、所有账户共享的模型（JSON 文件，权限 0600，内容见 docs/CONFIGURATION.md）：
# PLATFORM_MODEL_CONFIG=/path/to/platform-model.json

# 每个账户每个 UTC 日的模型用量预算；0 表示不限制。共享模型与个人模型分开计。
SHARED_MODEL_DAILY_TOKENS=0
PRIVATE_MODEL_DAILY_TOKENS=0
# 每次请求预留的保守额度，不是实际用量也不是计费依据。
MODEL_REQUEST_RESERVE_TOKENS=131072

# ────────────────────────────────────────────────── 研究助手与并发 / Assistant & concurrency
# 0 表示应用不设上限（上游服务自己的限流仍然有效）。
AGENT_ACTIVE_LIMIT=0
AGENT_DAILY_RUNS=0
AGENT_TRANSLATION_ACTIVE=0
AGENT_WORKER_CONCURRENCY=0
AGENT_TRANSLATION_WORKERS=0
PLATFORM_MODEL_CONCURRENCY=0
# worker 找不到 node 时指定绝对路径（Docker 镜像里已设置）。
# AGENT_NODE=/usr/bin/node

# ─────────────────────────────────────────────────────────── 翻译 / Translation
# 已完成翻译的中间文件在验证产物后过期；失败、取消或进行中的任务检查点不会按此清理。
# 设为 0 关闭对应清理。
TRANSLATION_CACHE_DAYS=7
TRANSLATION_ORPHAN_DAYS=30
# 只用于下载 arXiv 的 HTTP 代理，例如 http://127.0.0.1:7890。
# ARXIV_PROXY=

# ──────────────────────────────────────────────────────────── 备份 / Backup
# 离线备份脚本可选读取的 age 公钥文件；私钥放在另一台可信设备上。
# PAPER_BACKUP_RECIPIENT_FILE=/etc/paper-platform/backup-recipient.txt
# 本机保留最新的几份备份（默认 1）。
# PAPER_BACKUP_KEEP=1
