FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends bash python3 python3-venv poppler-utils ripgrep fd-find ca-certificates curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY agent-runtime/package.json agent-runtime/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY agent-runtime/sandbox-tools.mjs ./
COPY agent-runtime/skills ./skills
RUN curl -fsSL https://github.com/sharkdp/fd/releases/download/v10.3.0/fd-v10.3.0-$(uname -m)-unknown-linux-musl.tar.gz -o /tmp/fd.tar.gz && tar -xzf /tmp/fd.tar.gz -C /tmp && install /tmp/fd-v10.3.0-$(uname -m)-unknown-linux-musl/fd /usr/local/bin/fd && rm -rf /tmp/fd.tar.gz /tmp/fd-v10.3.0-*
ENV HOME=/work LANG=C.UTF-8
USER 65534:65534
WORKDIR /work
CMD ["node", "/app/sandbox-tools.mjs"]
