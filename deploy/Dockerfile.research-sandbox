# The research sandbox: the agent's file and shell tools, plus a CPU science stack.
# Runs with no network; everything an experiment needs has to be in here.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends bash python3 python3-pip python3-venv poppler-utils ripgrep ca-certificates curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY agent-runtime/package.json agent-runtime/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY agent-runtime/sandbox-tools.mjs ./
RUN curl -fsSL https://github.com/sharkdp/fd/releases/download/v10.3.0/fd-v10.3.0-$(uname -m)-unknown-linux-musl.tar.gz -o /tmp/fd.tar.gz && tar -xzf /tmp/fd.tar.gz -C /tmp && install /tmp/fd-v10.3.0-$(uname -m)-unknown-linux-musl/fd /usr/local/bin/fd && rm -rf /tmp/fd.tar.gz /tmp/fd-v10.3.0-*
RUN pip install --no-cache-dir --break-system-packages numpy scipy pandas scikit-learn matplotlib \
 && pip install --no-cache-dir --break-system-packages torch --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple
ENV HOME=/work LANG=C.UTF-8 MPLBACKEND=Agg PYTHONDONTWRITEBYTECODE=1
USER 65534:65534
WORKDIR /work
CMD ["node", "/app/sandbox-tools.mjs"]
